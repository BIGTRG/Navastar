# Navastar Web — build the SPA, then serve it (and reverse-proxy the API) via Caddy.
FROM node:20-alpine AS build
RUN corepack enable
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @navastar/db generate
RUN pnpm --filter @navastar/web build

# Final image: Caddy serves the static SPA + auto-HTTPS + proxies /api and /ws.
FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/apps/web/dist /srv
