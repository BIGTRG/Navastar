# ─────────────────────────────────────────────────────────────
# Navastar Logistics — environment template
# Copy to .env for local dev:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────
NODE_ENV=development
DOMAIN=navastarlogistics.com
API_PORT=4000
WEB_PORT=5173
# Public base URL the web app uses to reach the API
VITE_API_URL=http://localhost:4000
# Base URL the embeddable widget deep-links to (the web app)
WIDGET_WEB_URL=http://localhost:5173

# ── Auth ──────────────────────────────────────────────────────
# CHANGE THIS in production. Min 32 chars.
JWT_SECRET=dev-only-change-me-please-32-characters-min
JWT_EXPIRES_IN=7d

# ── Postgres ──────────────────────────────────────────────────
POSTGRES_USER=navastar
POSTGRES_PASSWORD=navastar
POSTGRES_DB=navastar
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://navastar:navastar@localhost:5432/navastar?schema=public

# ── Object storage (MinIO / S3-compatible) ────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=navastar-media
S3_ACCESS_KEY=navastar
S3_SECRET_KEY=navastar-secret
S3_FORCE_PATH_STYLE=true
# Real S3/MinIO adapter by default; set to `stub` for zero-infra runs.
STORAGE_PROVIDER=s3
# Public URL browsers use for presigned upload/download (defaults to S3_ENDPOINT).
S3_PUBLIC_URL=http://localhost:9000
# MinIO console: http://localhost:9001

# ── Maps ──────────────────────────────────────────────────────
# MVP uses Leaflet + OSM (no key). Set provider=here + key for production.
MAP_PROVIDER=osm
HERE_API_KEY=

# ── AI providers (all STUBBED for MVP; wire real vendors later) ─
AI_PROVIDER=stub
# Route AI outputs below this confidence to a human reviewer (0..1)
AI_CONFIDENCE_THRESHOLD=0.75
# Per-capability AI vendor selection (Module 15). stub keeps everything local.
#   inspection: stub | ravin | proovstation | navastar (our own model)
#   ocr: stub | vendor
AI_INSPECTION_PROVIDER=stub
AI_OCR_PROVIDER=stub
RAVIN_API_KEY=
PROOVSTATION_API_KEY=
OCR_API_KEY=

# ── Escrow / instant-payout provider (STUBBED for MVP) ─────────
ESCROW_PROVIDER=stub

# ── Payment processor (charges + payouts). Real vendor via env. ─
PAYMENT_PROVIDER=stub
STRIPE_SECRET_KEY=

# Demo simulators (movement/roam) — auto-disabled in production unless set true.
ENABLE_DEMO=true

# ── Event bus ─────────────────────────────────────────────────
# in-process emitter + transactional outbox for MVP; swap to kafka later
EVENT_BUS=inprocess

# ── FMCSA carrier lookup (free feed; stubbed for MVP) ──────────
FMCSA_WEBKEY=
